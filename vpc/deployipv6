#!/bin/bash

set -e

REGION="us-east-1"
AZ="us-east-1a"
KEYPAIR="dualstack-key"
PROJECT="dualstack-lab"

echo "=================================================="
echo " AWS Dual Stack VPC LAB (IPv4 + IPv6)"
echo "=================================================="

############################################
# STEP 1: CREATE VPC (IPv4 + IPv6)
############################################
echo "Creating VPC..."

vpcid=$(aws ec2 create-vpc \
  --cidr-block 192.168.0.0/16 \
  --amazon-provided-ipv6-cidr-block \
  --region $REGION \
  --query 'Vpc.VpcId' \
  --output text)

aws ec2 create-tags \
  --resources $vpcid \
  --tags Key=Name,Value=$PROJECT Key=Project,Value=$PROJECT \
  --region $REGION

aws ec2 modify-vpc-attribute --vpc-id $vpcid --enable-dns-support '{"Value":true}' --region $REGION
aws ec2 modify-vpc-attribute --vpc-id $vpcid --enable-dns-hostnames '{"Value":true}' --region $REGION

echo "VPC: $vpcid"

############################################
# STEP 2: PUBLIC SUBNET
############################################
echo "Creating Public Subnet..."

pubsub=$(aws ec2 create-subnet \
  --vpc-id $vpcid \
  --cidr-block 192.168.1.0/24 \
  --availability-zone $AZ \
  --region $REGION \
  --query 'Subnet.SubnetId' \
  --output text)

aws ec2 modify-subnet-attribute \
  --subnet-id $pubsub \
  --map-public-ip-on-launch \
  --region $REGION

echo "Public Subnet: $pubsub"

############################################
# STEP 3: PRIVATE SUBNET
############################################
echo "Creating Private Subnet..."

prvsub=$(aws ec2 create-subnet \
  --vpc-id $vpcid \
  --cidr-block 192.168.2.0/24 \
  --availability-zone $AZ \
  --region $REGION \
  --query 'Subnet.SubnetId' \
  --output text)

echo "Private Subnet: $prvsub"

############################################
# STEP 4: INTERNET GATEWAY
############################################
echo "Creating IGW..."

igw=$(aws ec2 create-internet-gateway \
  --region $REGION \
  --query 'InternetGateway.InternetGatewayId' \
  --output text)

aws ec2 attach-internet-gateway \
  --internet-gateway-id $igw \
  --vpc-id $vpcid \
  --region $REGION

############################################
# STEP 5: NAT GATEWAY
############################################
echo "Creating NAT Gateway..."

eip=$(aws ec2 allocate-address --domain vpc --region $REGION \
  --query AllocationId --output text)

natgw=$(aws ec2 create-nat-gateway \
  --subnet-id $pubsub \
  --allocation-id $eip \
  --region $REGION \
  --query 'NatGateway.NatGatewayId' \
  --output text)

echo "Waiting for NAT..."
aws ec2 wait nat-gateway-available --nat-gateway-ids $natgw --region $REGION

############################################
# STEP 6: ROUTE TABLES
############################################

echo "Creating Public Route Table..."

pubrt=$(aws ec2 create-route-table \
  --vpc-id $vpcid \
  --region $REGION \
  --query 'RouteTable.RouteTableId' \
  --output text)

aws ec2 create-route \
  --route-table-id $pubrt \
  --destination-cidr-block 0.0.0.0/0 \
  --gateway-id $igw \
  --region $REGION

aws ec2 associate-route-table \
  --route-table-id $pubrt \
  --subnet-id $pubsub \
  --region $REGION

echo "Creating Private Route Table..."

prvrt=$(aws ec2 create-route-table \
  --vpc-id $vpcid \
  --region $REGION \
  --query 'RouteTable.RouteTableId' \
  --output text)

aws ec2 create-route \
  --route-table-id $prvrt \
  --destination-cidr-block 0.0.0.0/0 \
  --nat-gateway-id $natgw \
  --region $REGION

aws ec2 associate-route-table \
  --route-table-id $prvrt \
  --subnet-id $prvsub \
  --region $REGION

############################################
# STEP 7: SECURITY GROUP
############################################

sg=$(aws ec2 create-security-group \
  --group-name dualstack-sg \
  --description "dual stack sg" \
  --vpc-id $vpcid \
  --region $REGION \
  --query GroupId \
  --output text)

aws ec2 authorize-security-group-ingress \
  --group-id $sg \
  --protocol tcp --port 22 \
  --cidr 0.0.0.0/0 \
  --region $REGION

############################################
# STEP 8: KEYPAIR
############################################

aws ec2 create-key-pair \
  --key-name $KEYPAIR \
  --region $REGION \
  --query KeyMaterial \
  --output text > ${KEYPAIR}.pem

chmod 400 ${KEYPAIR}.pem

############################################
# STEP 9: EC2 INSTANCES
############################################

echo "Launching Public EC2..."

pubec2=$(aws ec2 run-instances \
  --image-id ami-0d77bccb32adafa57 \
  --instance-type t3.micro \
  --key-name $KEYPAIR \
  --subnet-id $pubsub \
  --security-group-ids $sg \
  --associate-public-ip-address \
  --tag-specifications "ResourceType=instance,Tags=[{Key=Project,Value=$PROJECT},{Key=Name,Value=public-ec2}]" \
  --region $REGION \
  --query 'Instances[0].InstanceId' \
  --output text)

echo "Launching Private EC2..."

prvec2=$(aws ec2 run-instances \
  --image-id ami-0d77bccb32adafa57 \
  --instance-type t3.micro \
  --key-name $KEYPAIR \
  --subnet-id $prvsub \
  --security-group-ids $sg \
  --tag-specifications "ResourceType=instance,Tags=[{Key=Project,Value=$PROJECT},{Key=Name,Value=private-ec2}]" \
  --region $REGION \
  --query 'Instances[0].InstanceId' \
  --output text)

aws ec2 wait instance-running --instance-ids $pubec2 $prvec2 --region $REGION

############################################
# STEP 10: IPv6 ROUTING (EGRESS ONLY IGW)
############################################

echo "Creating Egress-Only IGW..."

eigw=$(aws ec2 create-egress-only-internet-gateway \
  --vpc-id $vpcid \
  --region $REGION \
  --query 'EgressOnlyInternetGateway.EgressOnlyInternetGatewayId' \
  --output text)

aws ec2 create-route \
  --route-table-id $prvrt \
  --destination-ipv6-cidr-block ::/0 \
  --egress-only-internet-gateway-id $eigw \
  --region $REGION

############################################
# STEP 11: OUTPUT
############################################

pubip=$(aws ec2 describe-instances \
  --instance-ids $pubec2 \
  --region $REGION \
  --query 'Reservations[0].Instances[0].PublicIpAddress' \
  --output text)

echo "=========================================="
echo "PUBLIC EC2 IP: $pubip"
echo "SSH: ssh -i ${KEYPAIR}.pem ubuntu@$pubip"
echo "=========================================="

############################################
# STEP 12: CLEANUP (AFTER TESTING)
############################################

read -p "Do you want to DELETE ALL resources now? (yes/no): " del

if [[ "$del" == "yes" ]]; then

echo "Cleaning up..."

aws ec2 terminate-instances --instance-ids $pubec2 $prvec2 --region $REGION
aws ec2 wait instance-terminated --instance-ids $pubec2 $prvec2 --region $REGION

aws ec2 delete-egress-only-internet-gateway --egress-only-internet-gateway-id $eigw --region $REGION || true
aws ec2 delete-nat-gateway --nat-gateway-id $natgw --region $REGION || true

sleep 300

aws ec2 delete-route-table --route-table-id $pubrt --region $REGION || true
aws ec2 delete-route-table --route-table-id $prvrt --region $REGION || true

aws ec2 delete-subnet --subnet-id $pubsub --region $REGION || true
aws ec2 delete-subnet --subnet-id $prvsub --region $REGION || true

aws ec2 detach-internet-gateway --internet-gateway-id $igw --vpc-id $vpcid --region $REGION || true
aws ec2 delete-internet-gateway --internet-gateway-id $igw --region $REGION || true

aws ec2 delete-security-group --group-id $sg --region $REGION || true
aws ec2 delete-vpc --vpc-id $vpcid --region $REGION || true

aws ec2 delete-key-pair --key-name $KEYPAIR --region $REGION || true
rm -f ${KEYPAIR}.pem

echo "Cleanup done."

fi