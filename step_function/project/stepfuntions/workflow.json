{
  "Comment": "CSV Processing Workflow",
  "StartAt": "ValidateCSV",
  "States": {
    "ValidateCSV": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:us-east-1:832014379019:function:validate-csv",
      "Next": "ParallelProcessing",
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "WorkflowFailed"
        }
      ]
    },
    "ParallelProcessing": {
      "Type": "Parallel",
      "Branches": [
        {
          "StartAt": "GenerateStatistics",
          "States": {
            "GenerateStatistics": {
              "Type": "Task",
              "Resource": "arn:aws:lambda:us-east-1:832014379019:function:generate-statistics",
              "End": true
            }
          }
        },
        {
          "StartAt": "GenerateCharts",
          "States": {
            "GenerateCharts": {
              "Type": "Task",
              "Resource": "arn:aws:lambda:us-east-1:832014379019:function:generate-charts",
              "End": true
            }
          }
        }
      ],
      "Next": "GeneratePDF"
    },
    "GeneratePDF": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:us-east-1:832014379019:function:generate-pdf",
      "TimeoutSeconds": 60,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "WorkflowFailed"
        }
      ],
      "End": true
    },
    "WorkflowFailed": {
      "Type": "Fail",
      "Cause": "CSV Processing Failed"
    }
  }
}